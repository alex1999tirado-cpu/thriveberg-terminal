Screen {
    background: #030404;
    color: #d7d7d7;
    link-style: not underline;
    link-style-hover: bold not underline;
}

Static {
    link-style: not underline;
    link-style-hover: bold not underline;
}

#root {
    height: 100%;
    width: 100%;
    background: #030404;
}

#topbar {
    height: 2;
    background: #2a2a2a;
    padding: 0;
}

#topbar-brand, #topbar-actions {
    width: 100%;
    height: 1;
    padding: 0 1;
    overflow: hidden hidden;
}

#topbar-brand {
    background: #111111;
    color: #ffb000;
    text-style: bold;
}

#topbar-actions {
    background: #343434;
    color: #d7d7d7;
    link-style: not underline;
    link-style-hover: bold reverse not underline;
}

#instrument-strip {
    width: 100%;
    height: 2;
}

#instrument-function {
    width: 100%;
    height: 1;
    background: #97001d;
    color: #ffffff;
    text-style: bold;
    padding: 0 1;
    overflow: hidden hidden;
}

#instrument-market {
    width: 100%;
    height: 1;
    background: #050505;
    color: #d7d7d7;
    padding: 0 1;
    overflow: hidden hidden;
}

#command {
    height: 1;
    background: #050505;
    color: #ffb000;
    border: none;
    padding: 0 1;
}

#command-suggestions {
    display: none;
    overlay: screen;
    constrain: none inside;
    width: 72;
    height: auto;
    max-height: 8;
    margin: 0 0 0 1;
    border: tall #6b6b6b;
    background: #101214;
    color: #d7d7d7;
    scrollbar-color: #ffb000;
    scrollbar-background: #111111;
}

#command-suggestions > .option-list--option {
    height: 1;
    padding: 0 1;
}

#command-suggestions > .option-list--option-highlighted {
    background: #ffb000;
    color: #000000;
    text-style: bold;
}

Input {
    background: #050505;
    color: #ffb000;
    border: none;
}

Input:focus {
    border: none;
}

#body {
    height: 1fr;
    width: 100%;
}

#main-pane {
    width: 1fr;
    height: 100%;
}

#main-scroll {
    width: 100%;
    height: 100%;
    border: none;
    padding: 0 1;
    overflow-y: auto;
    scrollbar-color: #ffb000;
    scrollbar-background: #111111;
}

#main {
    width: 100%;
    height: auto;
}

#chart-screen {
    display: none;
    width: 100%;
    height: 100%;
    border: none;
    background: #050607;
}

#chart-screen:focus {
    border: none;
}

#chart-header {
    width: 100%;
    height: 3;
    background: #0b0d0f;
}

#chart-header-identity, #chart-header-quote, #chart-header-session {
    width: 100%;
    height: 1;
    padding: 0 1;
    overflow: hidden hidden;
}

#chart-header-identity {
    background: #17191c;
    color: #d7d7d7;
}

#chart-header-quote {
    background: #111315;
    color: #e7e7e7;
}

#chart-header-session {
    background: #090b0d;
    color: #aeb6bf;
}

#chart-controls {
    width: 100%;
    height: 2;
}

#chart-range-row, #chart-tools-row {
    height: 1;
    width: 100%;
    background: #0c0e10;
    padding: 0;
}

.chart-control-label {
    width: 5;
    height: 1;
    color: #ffb000;
    content-align: center middle;
}

.chart-segment {
    min-width: 4;
    width: 5;
    min-height: 1;
    height: 1;
    margin: 0;
    border: none;
    padding: 0;
    background: #171c21;
    color: #d7dce2;
    content-align: center middle;
}

.chart-segment:hover {
    background: #30363d;
}

.chart-segment.selected, .chart-toggle.selected {
    background: #d99116;
    color: #050607;
    text-style: bold;
}

.chart-toggle {
    width: 5;
    min-width: 5;
    min-height: 1;
    height: 1;
    margin: 0;
    border: none;
    padding: 0;
    background: #171c21;
    color: #8f99a3;
    content-align: center middle;
}

.chart-tool {
    width: 7;
    height: 1;
    min-width: 6;
    min-height: 1;
    margin: 0;
    border: none;
    padding: 0;
    background: #303338;
    color: #e1e3e5;
    content-align: center middle;
}

.chart-tool:hover, .chart-tool.selected {
    background: #d99116;
    color: #050607;
}

#chart-refresh {
    width: 9;
    min-width: 9;
}

#chart-reset {
    width: 7;
    min-width: 7;
}

#chart-popout {
    width: 9;
    min-width: 9;
}

#chart-news {
    width: 6;
    min-width: 6;
}

#chart-clear {
    width: 7;
    min-width: 7;
}

#chart-hline {
    width: 8;
    min-width: 8;
}

#chart-image {
    width: 100%;
    height: 1fr;
    min-height: 10;
    background: #050607;
}

#chart-analytics {
    width: 100%;
    height: 4;
    background: #090b0d;
}

#chart-analytics-title {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: #13171b;
    color: #7fd7ff;
    overflow: hidden hidden;
}

#chart-analytics-grid {
    width: 100%;
    height: 3;
    padding: 0 1;
    color: #d7d7d7;
    overflow: hidden hidden;
}

#chart-footer {
    width: 100%;
    height: 2;
}

#chart-status {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: #111417;
    color: #8f99a3;
}

#chart-status.mock {
    color: #ffb000;
}

#chart-status.error {
    color: #ff4242;
}

#chart-shortcuts {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: #0b0d0f;
    color: #7fd7ff;
    overflow: hidden hidden;
}

#news-screen {
    display: none;
    width: 100%;
    height: 100%;
    border: tall #3d434a;
    background: #050607;
}

#news-screen:focus-within {
    border: tall #8a6f12;
}

#news-topic-row {
    width: 100%;
    height: 1;
    background: #0c0e10;
}

.news-topic {
    width: 9;
    min-width: 7;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0;
    border: none;
    background: #171c21;
    color: #d7dce2;
    content-align: center middle;
}

.news-topic:hover, .news-topic.selected {
    background: #d99116;
    color: #050607;
    text-style: bold;
}

.news-action {
    width: 9;
    min-width: 7;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0;
    border: none;
    background: #293038;
    color: #ffb000;
    content-align: center middle;
}

#news-open {
    width: 7;
}

#news-wire {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: #121518;
    color: #aeb6bf;
    overflow: hidden hidden;
}

#news-body {
    width: 100%;
    height: 1fr;
}

#news-table {
    width: 1fr;
    height: 100%;
    background: #050607;
    color: #d7d7d7;
    border: none;
    scrollbar-color: #ffb000;
    scrollbar-background: #111111;
}

#news-table:focus {
    border: none;
}

#news-table > .datatable--header {
    background: #303338;
    color: #ffb000;
    text-style: bold;
}

#news-table > .datatable--cursor {
    background: #d99116;
    color: #050607;
}

#news-detail {
    width: 40;
    min-width: 32;
    height: 100%;
    padding: 1;
    border-left: solid #343a40;
    background: #090b0d;
    color: #d7d7d7;
    overflow-y: auto;
    scrollbar-color: #ffb000;
    scrollbar-background: #111111;
}

#options-screen {
    display: none;
    width: 100%;
    height: 100%;
    border: tall #8a6f12;
    background: #020304;
}

#options-screen:focus-within {
    border: tall #d0a800;
}

#options-chain-controls,
#options-pricer-nav,
#options-vol-tabs,
#options-vol-parameters {
    width: 100%;
    height: 1;
    background: #202327;
}

.options-action,
.options-vol-mode,
.option-side,
.options-icon {
    width: auto;
    min-width: 8;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
    background: #8c8f92;
    color: #101112;
    content-align: center middle;
}

.options-action:hover,
.options-vol-mode:hover,
.option-side:hover,
.options-icon:hover {
    background: #d9dadb;
    color: #050607;
    text-style: bold;
}

.options-vol-mode.selected,
.option-side.selected {
    background: #e7e7e7;
    color: #111111;
    text-style: bold;
}

.options-icon {
    width: 3;
    min-width: 3;
    padding: 0;
}

#options-market-line {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: #111417;
    color: #d7d7d7;
    overflow: hidden hidden;
}

#options-chain-summary {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: #050607;
    color: #d7d7d7;
    overflow: hidden hidden;
}

.options-view {
    width: 100%;
    height: 1fr;
}

.options-control-label {
    width: 11;
    height: 1;
    padding: 0 1;
    color: #ffb000;
    text-style: bold;
}

.options-control-label.compact {
    width: 5;
    min-width: 5;
}

.options-amber-field {
    width: 7;
    height: 1;
    padding: 0 1;
    background: #d99116;
    color: #050607;
    text-style: bold;
    content-align: center middle;
}

#options-expiry-label {
    width: 18;
    height: 1;
    color: #ffffff;
    content-align: center middle;
}

#options-price-call,
#options-price-put {
    min-width: 12;
}

#options-chain-table,
#options-vol-table-grid {
    width: 100%;
    height: 1fr;
    background: #050607;
    color: #d7d7d7;
    border: none;
    scrollbar-color: #696969;
    scrollbar-background: #111111;
}

#options-chain-body {
    width: 100%;
    height: 1fr;
}

#options-chain-body > #options-chain-table {
    width: 1fr;
    height: 100%;
}

#options-chain-analysis {
    width: 38;
    min-width: 34;
    height: 100%;
    padding: 0 1;
    border-left: solid #343a40;
    background: #050607;
}

#options-chain-table > .datatable--header,
#options-vol-table-grid > .datatable--header {
    background: #303338;
    color: #ffffff;
    text-style: bold;
}

#options-chain-table > .datatable--cursor,
#options-vol-table-grid > .datatable--cursor {
    background: #164d72;
    color: #ffffff;
}

#options-model-note {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: #111417;
    color: #8f99a3;
    overflow: hidden hidden;
}

#options-contract-detail {
    width: 100%;
    height: 1fr;
    padding: 1 0;
    background: #050607;
    color: #d7d7d7;
    overflow-y: auto;
}

#options-chain-footer {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: #111417;
    color: #8f99a3;
}

#options-pricer-body {
    width: 100%;
    height: 1fr;
    padding: 1 1 0 1;
}

.options-pricer-panel {
    height: 100%;
    padding: 0 1;
    border-right: solid #343a40;
}

#options-pricer-results {
    width: 46;
    min-width: 42;
}

#options-pricer-deal {
    width: 1fr;
    border-right: none;
}

#options-pricer-fields {
    width: 100%;
    height: 10;
}

#options-pricer-terms,
#options-pricer-market {
    width: 50;
    height: 100%;
    min-width: 28;
    padding-right: 2;
}

#options-pricer-market {
    padding-left: 2;
    border-left: solid #343a40;
}

.options-pricer-tab {
    width: auto;
    min-width: 16;
    height: 1;
    padding: 0 1;
    background: #8c8f92;
    color: #101112;
    content-align: center middle;
}

.options-pricer-tab.selected {
    background: #c6c9cc;
    color: #111111;
    text-style: bold;
}

.options-section-title {
    width: 100%;
    height: 1;
    color: #ffb000;
    text-style: bold;
}

#options-pricer-underlying {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: #050607;
    color: #d7d7d7;
    overflow: hidden hidden;
}

.option-field {
    width: 100%;
    height: 2;
    padding-top: 1;
}

.option-field-label {
    width: 14;
    min-width: 14;
    height: 1;
    color: #d7d7d7;
}

.option-input {
    width: 28;
    height: 1;
    min-height: 1;
    padding: 0 1;
    border: none;
    background: #d99116;
    color: #050607;
    text-style: bold;
}

.option-side {
    width: 8;
    min-width: 8;
}

#options-calculate,
#options-solve-iv,
#options-use-market {
    min-width: 12;
}

#options-result-grid {
    width: 100%;
    height: 16;
    padding: 0;
    background: #020304;
}

#options-conventions-grid {
    width: 100%;
    height: 7;
    padding: 1 0 0 1;
    color: #ffb000;
    border-top: solid #343a40;
}

#options-vol-method {
    width: 1fr;
    height: 1;
    padding-left: 1;
    color: #8f99a3;
    background: #050607;
    text-align: right;
    overflow: hidden hidden;
}

#options-vol-tabs {
    background: #303338;
}

#options-vol-tabs .options-vol-mode,
#options-vol-tabs .options-action {
    margin: 0;
    padding: 0 1;
    background: #8b8d90;
    color: #101112;
}

#options-vol-tabs .options-vol-mode:hover,
#options-vol-tabs .options-action:hover {
    background: #d0d2d4;
    color: #050607;
}

#options-vol-tabs .options-vol-mode.selected {
    background: #e7e7e7;
    color: #050607;
    text-style: bold;
}

#options-vol-parameters {
    background: #050607;
}

#options-vol-axis {
    width: 20;
    height: 1;
    padding: 0 1;
    background: #d99116;
    color: #050607;
    text-style: bold;
}

.options-vol-parameter {
    width: auto;
    height: 1;
    padding: 0 1;
    color: #c6c9cc;
    background: #050607;
}

.options-vol-parameter.active {
    color: #ffb000;
    text-style: bold;
}

#options-vol-image {
    width: 100%;
    height: 1fr;
    min-height: 12;
    background: #000000;
}

#options-vol-table-grid {
    display: none;
}

#social-screen {
    display: none;
    width: 100%;
    height: 100%;
    border: tall #3d434a;
    background: #050607;
}

#social-status {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: #121518;
    color: #aeb6bf;
}

#social-status.error {
    color: #ff5a5f;
}

#social-setup {
    width: 72;
    height: 15;
    padding: 1 2;
    align: center middle;
    border: solid #343a40;
}

#social-setup-note {
    width: 100%;
    height: 3;
    padding-top: 1;
    color: #8f99a3;
}

#social-auth {
    width: 100%;
    height: 1fr;
    align: center middle;
}

#social-auth-form {
    width: 58;
    height: 15;
    padding: 1 2;
    border-right: solid #343a40;
}

#social-auth-note {
    width: 46;
    height: 15;
    padding: 2;
    color: #8f99a3;
}

.social-section-title {
    width: 100%;
    height: 1;
    color: #ffb000;
    text-style: bold;
}

#social-auth Input, #social-setup Input, #social-search, #social-message {
    height: 1;
    margin: 1 0 0 0;
    padding: 0 1;
    border: none;
    background: #111417;
    color: #e7e7e7;
}

#social-dashboard {
    width: 100%;
    height: 1fr;
}

#social-directory {
    width: 44;
    min-width: 38;
    height: 100%;
    padding: 1;
    border-right: solid #343a40;
}

#social-conversation {
    width: 1fr;
    height: 100%;
}

#social-search-results {
    width: 100%;
    height: 1fr;
    min-height: 6;
    background: #050607;
    border: none;
    scrollbar-color: #696969;
    scrollbar-background: #111111;
}

#social-connections {
    width: 100%;
    height: 1fr;
    min-height: 6;
    background: #050607;
    border: none;
    scrollbar-color: #696969;
    scrollbar-background: #111111;
}

#social-search-results > .option-list--option,
#social-connections > .option-list--option {
    height: 1;
    padding: 0 1;
}

#social-search-results > .option-list--option-highlighted,
#social-connections > .option-list--option-highlighted {
    background: #353535;
    color: #ffffff;
}

.social-button-row {
    width: 100%;
    height: 2;
    padding: 1 0 0 0;
}

.social-action, .social-muted-action {
    width: auto;
    min-width: 9;
    height: 1;
    min-height: 1;
    margin: 0 1 0 0;
    padding: 0 1;
    border: none;
    background: #292d31;
    color: #d7d7d7;
}

.social-action:hover, .social-muted-action:hover {
    background: #454a50;
    color: #ffffff;
}

.social-muted-action {
    color: #8f99a3;
}

#social-chat-header {
    width: 100%;
    height: 2;
    padding: 1 2 0 2;
    background: #111417;
    color: #ffb000;
    text-style: bold;
}

#social-chat-scroll {
    width: 100%;
    height: 1fr;
    padding: 1 2;
    scrollbar-color: #696969;
    scrollbar-background: #111111;
}

#social-chat {
    width: 100%;
    height: auto;
}

#social-share-preview {
    width: 100%;
    height: 1;
    padding: 0 2;
    background: #111417;
    color: #7fd7ff;
}

#social-message {
    width: 100%;
}

#social-conversation > .social-button-row {
    padding-left: 2;
}

#sidebar {
    width: 38;
    min-width: 34;
    height: 100%;
}

#context {
    width: 100%;
    height: 1fr;
    border-left: solid #333333;
    border-bottom: solid #333333;
    padding: 0 1;
    overflow-y: auto;
}

#watchlist {
    width: 100%;
    height: 15;
    border-left: solid #333333;
    padding: 0 1;
    overflow-y: auto;
}

#hotkeys {
    height: 1;
    background: #111111;
    color: #7fd7ff;
    padding: 0 1;
}

.positive {
    color: #30ff78;
}

.negative {
    color: #ff4242;
}

.muted {
    color: #777777;
}
